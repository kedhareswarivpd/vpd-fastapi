# ==============================
# LOCAL DEVELOPMENT environment template.
#
# The application DATABASE is a local Postgres container (see
# docker-compose.override.yml, auto-loaded by `docker compose up`).
# AUTHENTICATION is fully CoreFusion-owned (app/services/auth_service.py) —
# no external identity provider is used in any environment.
#
# For staging, copy backend/.env.staging.example to backend/.env.staging
# instead (a Supabase-hosted Postgres, database layer only) — see
# docker-compose.staging.yml.
# ==============================
ENV=development
APP_NAME=CoreFusion Technologies
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=https://cf-azure-eta.vercel.app
PORT=8000

# ==============================
# DATABASE — local Postgres container (docker-compose.override.yml).
# Must match that file's POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD
# (LOCAL_DB_NAME/LOCAL_DB_USER/LOCAL_DB_PASSWORD env vars, defaulting to the
# values below if unset). No need to change these for local dev.
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corefusion
DB_USER=corefusion
DB_PASS=corefusion_dev_password
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ==============================
# REDIS — local container (docker-compose.yml). localhost here is for a
# host-run backend; docker-compose.override.yml overrides this to `redis`
# for the containerized backend. (Staging uses Upstash instead — see
# REDIS_URL_OVERRIDE in .env.staging.example; local dev has no reason to set
# it.)
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL_OVERRIDE=
REDIS_TLS=false

# ==============================
# EMAIL — Brevo's transactional email HTTP API (not SMTP). Used for
# contact-form notifications AND for CoreFusion's own auth emails (password
# reset, email verification, welcome, MFA notifications). Same account
# serves every environment. Get an API key from Brevo -> Settings -> SMTP &
# API -> API Keys. BREVO_SENDER_EMAIL must be a verified sender/domain in
# that Brevo account or sends will be rejected.
# ==============================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@corefusiontech.com
BREVO_SENDER_NAME=CoreFusion Technologies

# ==============================
# FILE UPLOADS — "local" (default here) writes straight to the local
# uploads/ folder, zero setup required. Set STORAGE_BACKEND=s3 to route
# through an S3-compatible bucket instead (MinIO locally via
# docker-compose.override.yml, Supabase Storage in staging — see
# .env.staging.example) and fill in the S3_* values below.
# ==============================
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=corefusion-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9000/corefusion-uploads
S3_AUTO_CREATE_BUCKET=true

# ==============================
# RATE LIMITING (enforced via Redis)
# ==============================
RATE_LIMIT=300/15minute

# ==============================
# MFA / 2FA (TOTP) — OFF by default for every account (MFA_ENABLED=false).
# Flipping this to true does NOT enable MFA for anyone automatically — each
# user still opts in individually via POST /auth/mfa/setup + /auth/mfa/enable.
# MFA_ENCRYPTION_KEY must be a valid Fernet key whenever MFA_ENABLED=true —
# generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================
MFA_ENABLED=false
MFA_ISSUER=CoreFusion Technologies
MFA_ENCRYPTION_KEY=

# ==============================
# OAUTH / SOCIAL LOGIN — OFF by default (OAUTH_ENABLED=false). Each provider
# below is additionally only active once its own CLIENT_ID/CLIENT_SECRET/
# REDIRECT_URI are all set, so leaving one provider blank while filling in
# the other is safe. REDIRECT_URI must exactly match what's registered in
# that provider's OAuth app settings, and point at THIS backend (not the
# frontend) — it's the backend's own callback route that completes the flow.
# SUCCESS/FAILURE_REDIRECT_URL are where the browser lands afterward on the
# frontend; both default to CLIENT_URL above if left blank.
# ==============================
OAUTH_ENABLED=false
OAUTH_SUCCESS_REDIRECT_URL=
OAUTH_FAILURE_REDIRECT_URL=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback
