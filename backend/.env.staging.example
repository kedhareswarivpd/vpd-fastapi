# ==============================
# STAGING environment template.
#
# Unlike backend/.env (local dev), this file is fully self-contained and
# points the DATABASE at Supabase's own Postgres, used purely as a hosted
# Postgres instance — AUTHENTICATION is fully CoreFusion-owned
# (app/services/auth_service.py) in every environment, Supabase is never
# consulted for identity/sessions/credentials. Loaded explicitly via
# `docker-compose.staging.yml` (backend.env_file), or by scripts/migrate.sh
# staging`/`both` (ENV_FILE=.env.staging). Redis is Upstash (managed,
# TLS-required) in staging — no local Redis container is used here, unlike
# local dev. File uploads go through Supabase Storage's own S3-compatible
# API (see the FILE UPLOADS section below) rather than local disk.
# ==============================
ENV=staging
APP_NAME=CoreFusion Technologies
API_PREFIX=/api/v1
CLIENT_URL=https://staging.corefusiontech.com
EXTRA_CORS_ORIGINS=https://cf-azure-eta.vercel.app
PORT=8000

# ==============================
# DATABASE — Supabase's Postgres (Project Settings -> Database).
# For serverless/many short-lived connections use the "Transaction pooler"
# host and port 6543 with DB_USE_PGBOUNCER=true. For a long-running server
# like this one, the direct connection (port 5432) also works fine with
# DB_USE_PGBOUNCER=false.
# ==============================
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-database-password
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ==============================
# REDIS — Upstash (managed, TLS-required Redis), NOT a local container.
# Get the connection string from the Upstash console: your database ->
# "Connect" -> the `rediss://default:<token>@<host>:<port>` string, pasted
# verbatim into REDIS_URL_OVERRIDE. When this is set, REDIS_HOST/PORT/
# PASSWORD/TLS below are ignored entirely (see core/config.py's redis_url
# property) — they're only listed for reference/fallback if you ever needed
# to point staging at a plain host/port Redis instead.
# ==============================
REDIS_URL_OVERRIDE=rediss://default:your-upstash-token@your-endpoint.upstash.io:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# ==============================
# EMAIL — Brevo's transactional email HTTP API (not SMTP). Same Brevo
# account/API key as local dev — see backend/.env's EMAIL section for the
# full explanation. BREVO_SENDER_EMAIL must be a verified sender/domain in
# that Brevo account.
# ==============================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@corefusiontech.com
BREVO_SENDER_NAME=CoreFusion Technologies

# ==============================
# FILE UPLOADS — Supabase Storage's own S3-compatible API (same bucket
# project as DATABASE above, or a separate Supabase project — either works,
# they're independent). In the Supabase dashboard: Storage -> Settings ->
# S3 Access Keys (NOT the anon/service_role keys from Project Settings ->
# API — those are for the Supabase client SDKs, not the S3 API used here).
# Create/name a bucket (public, so uploaded media is directly browsable) and
# put its name in S3_BUCKET.
# ==============================
STORAGE_BACKEND=s3
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=corefusion-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=https://your-project-ref.supabase.co/storage/v1/object/public/corefusion-uploads
S3_AUTO_CREATE_BUCKET=false

# ==============================
# RATE LIMITING (enforced via Redis)
# ==============================
RATE_LIMIT=300/15minute

# ==============================
# MFA / 2FA (TOTP) — OFF by default for every account (MFA_ENABLED=false).
# Flipping this to true does NOT enable MFA for anyone automatically — each
# user still opts in individually via POST /auth/mfa/setup + /auth/mfa/enable.
# MFA_ENCRYPTION_KEY must be a valid Fernet key whenever MFA_ENABLED=true, and
# MUST be its own value here, distinct from local dev's — generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes every existing user's stored MFA secret
# undecryptable — back it up like any other production secret.
# ==============================
MFA_ENABLED=false
MFA_ISSUER=CoreFusion Technologies
MFA_ENCRYPTION_KEY=

# ==============================
# OAUTH / SOCIAL LOGIN — OFF by default (OAUTH_ENABLED=false). Each provider
# below is additionally only active once its own CLIENT_ID/CLIENT_SECRET/
# REDIRECT_URI are all set. REDIRECT_URI must exactly match what's registered
# in that provider's OAuth app settings for this environment, and point at
# THIS backend's real staging/production hostname (not localhost, not the
# frontend) — it's the backend's own callback route that completes the flow.
# SUCCESS/FAILURE_REDIRECT_URL are where the browser lands afterward on the
# frontend; both default to CLIENT_URL above if left blank.
# ==============================
OAUTH_ENABLED=false
OAUTH_SUCCESS_REDIRECT_URL=
OAUTH_FAILURE_REDIRECT_URL=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://api.your-staging-domain.com/api/v1/auth/oauth/google/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=https://api.your-staging-domain.com/api/v1/auth/oauth/github/callback
